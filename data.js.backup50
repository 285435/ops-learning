class Dog(Animal):
    def speak(self):
        return f"{self.name}: Woof"

from abc import ABC, abstractmethod
class Shape(ABC):
    @abstractmethod
    def area(self): pass
\`\`\`

**装饰器**
\`\`\`python
import time
def timer(func):
    def wrapper(*args, **kwargs):
        start = time.time()
        result = func(*args, **kwargs)
        print(f"{func.__name__}: {time.time()-start:.2f}s")
        return result
    return wrapper

@timer
def slow():
    time.sleep(1)
\`\`\`

**常用模块**：os、sys、json、datetime、re、collections、itertools、pathlib、logging。`
